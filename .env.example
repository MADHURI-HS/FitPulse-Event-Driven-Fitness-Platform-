# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# Shared HMAC secret for JWTs (min 32 characters). Used by userservice (sign) and gateway (verify).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# MySQL password for the user database (used for both the app user and root in Docker)
DB_PASSWORD=change-me

# Gemini. The URL must NOT contain the key; the key is sent in the x-goog-api-key header.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
GEMINI_API_KEY=your-gemini-api-key
